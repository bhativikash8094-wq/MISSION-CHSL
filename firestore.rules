rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32)) &&
             (!('authProvider' in data) || (data.authProvider is string && data.authProvider.size() <= 32)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation for DayProgress
    function isValidDayProgress(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() <= 128 &&
             data.day is number &&
             data.day >= 1 && data.day <= 45 &&
             data.completed is bool &&
             (!('arithmeticDone' in data) || data.arithmeticDone is bool) &&
             (!('advancedDone' in data) || data.advancedDone is bool) &&
             (!('reasoningDone' in data) || data.reasoningDone is bool) &&
             (!('englishDone' in data) || data.englishDone is bool) &&
             (!('gkDone' in data) || data.gkDone is bool) &&
             (!('arithmeticQs' in data) || (data.arithmeticQs is number && data.arithmeticQs >= 0 && data.arithmeticQs <= 1000)) &&
             (!('advancedQs' in data) || (data.advancedQs is number && data.advancedQs >= 0 && data.advancedQs <= 1000)) &&
             (!('reasoningQs' in data) || (data.reasoningQs is number && data.reasoningQs >= 0 && data.reasoningQs <= 1000)) &&
             (!('englishQs' in data) || (data.englishQs is number && data.englishQs >= 0 && data.englishQs <= 1000)) &&
             (!('gkGsQs' in data) || (data.gkGsQs is number && data.gkGsQs >= 0 && data.gkGsQs <= 1000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             data.updatedAt is timestamp;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'phoneNumber', 'authProvider', 'updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      // Subcollection for daily study progress
      match /studyProgress/{dayId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(dayId) &&
                         isValidDayProgress(incoming()) &&
                         incoming().updatedAt == request.time;
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(dayId) &&
                         isValidDayProgress(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().day == existing().day &&
                         incoming().updatedAt == request.time;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(dayId);
      }
    }
  }
}
